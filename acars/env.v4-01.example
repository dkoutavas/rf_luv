# ACARS pipeline environment (optional overrides).
#
# Copy to acars/.env on this host (docker compose reads it for ${VAR}
# substitution):
#   cp acars/env.v4-01.example acars/.env
#
# Start and stop with pipeline.sh, which picks the dongle, exports its
# RTL_TCP_PORT, and pauses that dongle's scanner while acarsdec holds rtl_tcp:
#   ./pipeline.sh up acars v4-01
#   ./pipeline.sh down acars v4-01     # resumes the scanner
# rtl-tcp@<serial> and its watchdog keep running; acarsdec is a TCP client.

# ── Tuner: rtl_tcp connection via SoapySDR ───────────────
# Leave SOAPYSDR unset: the overlay builds it from RTL_TCP_PORT, which
# pipeline.sh sets for the chosen dongle. Setting it here pins one port and
# silently overrides the dongle choice.
# SOAPYSDR=driver=rtltcp,rtltcp=host.docker.internal:1234

# ── ACARS frequencies (European plan) ───────────────────
# acarsdec accepts up to 5 channels in one ~2 MHz tuning window centered
# on the median. 131.525/131.725/131.825 spans ~300 kHz, well within range.
# Semicolon-separated per the docker-acarsdec convention.
ACARS_FREQUENCIES=131.525;131.725;131.825

# ── Tuner gain ──────────────────────────────────────────
# RTL gain in dB. -10 = autogain (often noisier than fixed). Airband clipped on
# the V4 at gain 12 in September 2026, so start at 12 and watch err_count in the
# dashboard; if it climbs over 0.3 avg, drop by 2-3.
ACARS_GAIN=12

# ── Frequency calibration ───────────────────────────────
# PPM correction. Leave at 0 unless V4's TCXO drift was characterized.
ACARS_PPM=0

# ── Identity / classifier feedback ──────────────────────
# Tagged on every row in acars.messages so cross-pipeline queries can
# attribute messages to the source dongle.
ACARS_DONGLE_ID=v4-01

# Feed ID embedded by acarsdec in the JSON output. Distinguishes this
# instance from any future second ACARS receiver.
ACARS_FEED_ID=rf_luv-v4-01

# ── Logging ─────────────────────────────────────────────
ACARS_QUIET_LOGS=false
TZ=UTC

# ── Ingest tuning ───────────────────────────────────────
# ACARS at LGAV is sparse-but-bursty; small batch + long flush keeps
# dashboards responsive without over-INSERTing.
BATCH_SIZE=100
FLUSH_INTERVAL_SECONDS=10

# ── ClickHouse ──────────────────────────────────────────
# Default password is dev-only. Set a non-trivial value (env-only, not
# committed) before exposing the shared ClickHouse.
CLICKHOUSE_PASSWORD=acars_local
