# Copy to infra/.env (gitignored) and fill in real values before infra/up.sh.
# There is intentionally NO committed admin-password fallback: compose
# substitutes ${CH_ADMIN_PASSWORD} with the empty string if .env is missing,
# and the ClickHouse healthcheck (and ch-bootstrap) will then fail loudly
# rather than silently booting with a blank admin password.

# Built-in ClickHouse 'default' admin password. Used by the healthcheck and by
# ch-bootstrap to create the per-db users/grants. The per-db users themselves
# keep the fixed convention password '<db>_local' that each pipeline's config
# already defaults to; only this admin password is a real secret.
CH_ADMIN_PASSWORD=change-me-admin

# Grafana admin login (optional; both default to 'admin' in compose.yml).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
