# /etc/rtl-scanner/notify.env. Copy this file (NOT into git).
#
# Default: leave NTFY_TOPIC empty. Alerts then pop up on the desktop of the
# user with DESKTOP_UID (D-Bus Notify on that user's session bus). Root-level
# alerts (escalator, probes) reach the desktop the same way.
#
# Phone alerts: set NTFY_TOPIC to a long random name (anyone who knows the
# topic can read AND write to it on the public ntfy.sh server), e.g.
# rf_luv_<8-random-chars>, and subscribe to it in the ntfy app. Set
# NTFY_LOCAL=1 to also show each phone alert on the desktop.
# To self-host, point NTFY_URL at your own ntfy server.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
DESKTOP_UID=1000
