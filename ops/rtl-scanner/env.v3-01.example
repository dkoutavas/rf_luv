# rtl-scanner environment file for v3-01 (RTL-SDR Blog V3, the ghost-pipeline dongle)
#
# Install to /etc/rtl-scanner/v3-01.env. Consumed by rtl-tcp@v3-01.service
# (for the RTL_TCP_* vars). On the two-dongle Omen the V3 serves rtl_tcp for
# the ghost/ pipeline (spirit-box replica), NOT the spectrum scanner, so
# rtl-scanner@v3-01.service is normally left disabled. The SCAN_* / CLICKHOUSE_*
# vars below are only read if you also run the scanner on this dongle; they are
# harmless otherwise.
#
# The V4 (v4-01) runs the scanner on port 1234; this V3 runs on port 1235 so
# the two rtl_tcp instances do not collide. See spectrum/docs/dongle_identity.md.

# ── Identity ─────────────────────────────────────────────
# Must match the dongle serial written via rtl_eeprom. See
# spectrum/docs/dongle_identity.md.
SCAN_DONGLE_ID=v3-01

# ── rtl_tcp ──────────────────────────────────────────────
# Port 1235: the V3 is the ghost dongle. The V4 scanner owns 1234, so the two
# rtl_tcp instances must differ here. BIND=0.0.0.0 is fine on a single host;
# the firewall governs external access. Leave the FM notch OFF on this dongle
# (ghost needs the FM band wide open); drop SCAN_GAIN first if Athens FM overloads.
RTL_TCP_HOST=127.0.0.1
RTL_TCP_PORT=1235
RTL_TCP_BIND=0.0.0.0
RTL_TCP_SAMPLE_RATE=2048000

# ── Sweep configuration (only used if rtl-scanner@v3-01 is enabled) ──
SCAN_FREQ_START=88000000
SCAN_FREQ_END=470000000
SCAN_BIN_WIDTH=100000
SCAN_GAIN=12
SCAN_GAIN_MIN=2
SCAN_FFT_SIZE=1024
SCAN_SAMPLE_RATE=2048000
SCAN_NUM_AVERAGES=8
SCAN_INTERVAL_SECONDS=280
SCAN_AIRBAND_INTERVAL=60
SCAN_AIRBAND_START=118000000
SCAN_AIRBAND_END=137000000
SCAN_PEAK_THRESHOLD=10
SCAN_PEAK_NEIGHBORS=5
SCAN_TRANSIENT_THRESHOLD=15

# ── Antenna tracking (recorded per run for A/B comparisons) ──────────
SCAN_ANTENNA_POSITION=window_dipole
SCAN_ANTENNA_ARMS_CM=75
SCAN_ANTENNA_ORIENTATION=0
SCAN_ANTENNA_HEIGHT_M=1
SCAN_NOTES=V3 bare (no FM notch), ghost-pipeline dongle

# ── ClickHouse (only used if rtl-scanner@v3-01 is enabled) ──
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=spectrum
CLICKHOUSE_USER=spectrum
CLICKHOUSE_PASSWORD=spectrum_local

# ── Ingest ───────────────────────────────────────────────
BATCH_SIZE=500
FLUSH_INTERVAL_SECONDS=5
