# rtl-scanner environment file for v3-01 (RTL-SDR Blog V3).
#
# Install to /etc/rtl-scanner/v3-01.env. Consumed by rtl-tcp@v3-01 and
# rtl-scanner@v3-01. Since 2026-09-26 the V3 is the official scanner dongle
# (the V4 was water-damaged); it is also the dongle for FM-band work (ghost,
# RDS), since it runs with no FM notch. Lend it to those with
# `ops/rf-mode pause v3-01` or `pipeline.sh up <pipe> v3-01`.
#
# It runs rtl_tcp on port 1235 so it does not collide with the V4 on 1234.
# See spectrum/docs/dongle_identity.md.

# ── Identity ─────────────────────────────────────────────
# Must match the dongle serial written via rtl_eeprom. See
# spectrum/docs/dongle_identity.md.
SCAN_DONGLE_ID=v3-01

# ── rtl_tcp ──────────────────────────────────────────────
# Port 1235, distinct from the V4's 1234. BIND=0.0.0.0 lets Docker decoders
# reach it; the firewall governs outside access.
RTL_TCP_HOST=127.0.0.1
RTL_TCP_PORT=1235
RTL_TCP_BIND=0.0.0.0
RTL_TCP_SAMPLE_RATE=2048000


# ── Sweep configuration ──────────────────────────────────
SCAN_FREQ_START=88000000
SCAN_FREQ_END=470000000
SCAN_BIN_WIDTH=100000
SCAN_GAIN=12
SCAN_GAIN_MIN=2
SCAN_FFT_SIZE=1024
SCAN_SAMPLE_RATE=2048000
SCAN_NUM_AVERAGES=8
SCAN_INTERVAL_SECONDS=280
SCAN_AIRBAND_INTERVAL=60
SCAN_AIRBAND_START=118000000
SCAN_AIRBAND_END=137000000
SCAN_PEAK_THRESHOLD=10
SCAN_PEAK_NEIGHBORS=5
SCAN_TRANSIENT_THRESHOLD=15

# ── Antenna tracking (recorded in scan_runs for every run) ──────────
SCAN_ANTENNA_POSITION=patio_roof_tripod_south
SCAN_ANTENNA_ARMS_CM=67
SCAN_ANTENNA_ORIENTATION=180
SCAN_ANTENNA_HEIGHT_M=2.7
SCAN_NOTES=describe the setup: filter fitted or not, anything unusual

# ── ClickHouse (only used if rtl-scanner@v3-01 is enabled) ──
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=spectrum
CLICKHOUSE_USER=spectrum
CLICKHOUSE_PASSWORD=spectrum_local

# ── Ingest ───────────────────────────────────────────────
BATCH_SIZE=500
FLUSH_INTERVAL_SECONDS=5
