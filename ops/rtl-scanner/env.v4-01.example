# rtl-scanner environment file for v4-01 (RTL-SDR Blog V4).
#
# ops/install-host.sh copies this to /etc/rtl-scanner/<serial>.env (it is also
# the template for any serial without its own example) and fills in
# SCAN_DONGLE_ID, RTL_TCP_PORT and SCAN_GAIN. Consumed by rtl-tcp@<serial> and
# rtl-scanner@<serial>. Edit the antenna fields whenever the antenna moves;
# each scanner restart records them in a new scan_runs row.

# ── Identity ─────────────────────────────────────────────
# Must match the V4 serial written via rtl_eeprom. See
# spectrum/docs/dongle_identity.md for the serial-write procedure.
SCAN_DONGLE_ID=v4-01

# ── rtl_tcp ──────────────────────────────────────────────
# Port 1234: one rtl_tcp per dongle, one client at a time (see rf-mode pause).
# BIND=0.0.0.0 lets Docker decoders reach it; the firewall governs outside access.
RTL_TCP_HOST=127.0.0.1
RTL_TCP_PORT=1234
RTL_TCP_BIND=0.0.0.0
RTL_TCP_SAMPLE_RATE=2048000


# ── Sweep configuration ──────────────────────────────────
SCAN_FREQ_START=88000000
SCAN_FREQ_END=470000000
SCAN_BIN_WIDTH=100000

# Gain in dB. The scanner steps it down by itself (to SCAN_GAIN_MIN) when a
# sweep clips more than 5%, so this is the starting point. Measured at
# Polygono (2026-09): 12 with an FM bandstop fitted or an indoor antenna;
# outdoors on the patio with no bandstop, FM saturates the dongle and it
# settles at 2-3.7. Gain 20 clips on Athens FM and airband.
SCAN_GAIN=12
SCAN_GAIN_MIN=2

SCAN_FFT_SIZE=1024
SCAN_SAMPLE_RATE=2048000
SCAN_NUM_AVERAGES=8
SCAN_INTERVAL_SECONDS=280
SCAN_AIRBAND_INTERVAL=60
SCAN_AIRBAND_START=118000000
SCAN_AIRBAND_END=137000000
SCAN_PEAK_THRESHOLD=10
SCAN_PEAK_NEIGHBORS=5
SCAN_TRANSIENT_THRESHOLD=15

# ── Antenna tracking ─────────────────────────────────────
# Recorded in scan_runs for every run, so data from different antenna setups
# can be told apart later. Arms: 7125 / f_MHz cm per arm (quarter wave).
SCAN_ANTENNA_POSITION=outdoor_window_suction_south
SCAN_ANTENNA_ARMS_CM=67
SCAN_ANTENNA_ORIENTATION=180
SCAN_ANTENNA_HEIGHT_M=1.8
SCAN_NOTES=describe the setup: filter fitted or not, anything unusual

# ── ClickHouse ───────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=spectrum
CLICKHOUSE_USER=spectrum
CLICKHOUSE_PASSWORD=spectrum_local

# ── Ingest ───────────────────────────────────────────────
BATCH_SIZE=500
FLUSH_INTERVAL_SECONDS=5
