# Overrides for rtl-tcp-escalator.py. Install to /etc/rtl-scanner/escalator.env
# (KEY=VALUE, one per line). Every key here has a built-in default in the script;
# this file only changes them for the local host.

# Two-dongle Omen: the escalator must watch both serials so a CB-open V3 (ghost
# dongle) is unwedged like the V4. With both listed, the "both serials CB-open
# >= REBOOT_BOTH_CB_S" reboot condition can also fire (only if REBOOT_ENABLED=1).
SERIALS=v4-01,v3-01

# Whole-machine reboot rung. OFF by default: on this personal desktop a reboot is
# disruptive. The Omen owns its USB bus (native Linux), so the per-device and
# xHCI-bounce steps already work; the reboot is a last resort. Set to 1 to arm it.
# NOTE: the xHCI bounce (XHCI_PCI) resets the whole controller and briefly drops
# BOTH dongles, not just the stuck one.
REBOOT_ENABLED=0

# PCI address of the xHCI controller the dongles sit on. Verify on this host with
# `lspci | grep -i usb` / `readlink /sys/bus/usb/devices/<dev>`; the default below
# was leap's and MUST be confirmed on the Omen before the escalator is trusted.
# XHCI_PCI=0000:00:14.0
