--- a/src/rtl_tcp.c
+++ b/src/rtl_tcp.c
@@ -91,6 +91,15 @@
 
 static volatile int do_exit = 0;
 
+/* rf_luv: a client disconnect used to call the signal handler from a worker
+ * thread, which cancelled the async read while command_worker could still be
+ * inside a USB control transfer (a retune sent just before the close). The
+ * teardown in rtlsdr_read_async() then raced it: libusb aborted with
+ * "usbi_mutex_destroy: Assertion `pthread_mutex_destroy(mutex) == 0' failed"
+ * or the session hung. dev_lock orders the two: a command either finishes
+ * before the stream is cancelled, or is skipped after it. */
+static pthread_mutex_t dev_lock = PTHREAD_MUTEX_INITIALIZER;
+
 
 void usage(void)
 {
@@ -152,6 +161,19 @@
 }
 #endif
 
+/* Client gone: stop the stream, but never in the middle of a device command.
+ * Real signals keep sighandler(); locking a mutex there could deadlock. */
+static void request_exit(void)
+{
+	pthread_mutex_lock(&dev_lock);
+	if (!do_exit) {
+		fprintf(stderr, "client gone, stopping stream\n");
+		do_exit = 1;
+		rtlsdr_cancel_async(dev);
+	}
+	pthread_mutex_unlock(&dev_lock);
+}
+
 void rtlsdr_callback(unsigned char *buf, uint32_t len, void *ctx)
 {
 	if(!do_exit) {
