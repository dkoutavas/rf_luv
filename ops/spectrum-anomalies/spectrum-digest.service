[Unit]
Description=rf_luv daily digest: signal of the day and anomaly counts (one-shot)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/dev/rf_luv/spectrum/anomalies.py --digest
Environment=CLICKHOUSE_HOST=localhost
Environment=CLICKHOUSE_PORT=8123
Environment=CLICKHOUSE_DB=spectrum
Environment=CLICKHOUSE_USER=spectrum
Environment=CLICKHOUSE_PASSWORD=spectrum_local
TimeoutStartSec=300
Restart=no

[Install]
WantedBy=default.target
