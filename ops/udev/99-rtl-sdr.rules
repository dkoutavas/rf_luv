# RTL-SDR Blog V3/V4 stable-name symlinks by serial.
#
# Matches USB vendor 0bda and product 2838 (RTL2838UHIDIR — shared by
# RTL-SDR Blog V3 and V4), creating a /dev symlink keyed on the serial
# written via rtl_eeprom. Downstream tools (rtl-tcp-by-serial wrapper,
# rtl-usb-reset) resolve the current USB index via these symlinks so
# enumeration order cannot cross the streams.
#
# Install on the local host with:
#   sudo cp ops/udev/99-rtl-sdr.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo udevadm trigger --subsystem-match=usb
#
# After install, each dongle re-enumeration creates /dev/rtl_sdr_v4 per its
# serial. See spectrum/docs/dongle_identity.md for the full setup procedure.
# On the native Tumbleweed host these rules are always in effect (Linux owns the USB bus).

# The V4 is the spectrum scanner dongle (FM notch on).
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", ATTRS{serial}=="v4-01", SYMLINK+="rtl_sdr_v4", MODE="0666", GROUP="__GROUP__"
# The V3 is the ghost-pipeline dongle (bare, no FM notch).
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", ATTRS{serial}=="v3-01", SYMLINK+="rtl_sdr_v3", MODE="0666", GROUP="__GROUP__"
# Any other 0bda:2838 dongle, any serial: /dev/rtl_sdr_<serial> (e.g.
# /dev/rtl_sdr_v4-01). Lets ops/install-host.sh address a dongle by serial
# without a per-serial line here. __GROUP__ is substituted at install time by
# ops/rtl-tcp/install.sh with the first of plugdev/users/dialout that exists
# on the host (openSUSE has no plugdev; a missing group voids the whole rule).
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", SYMLINK+="rtl_sdr_$attr{serial}", MODE="0666", GROUP="__GROUP__"
