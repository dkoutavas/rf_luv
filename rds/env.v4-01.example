# RDS pipeline environment for the local V4.
#
# Copy to rds/.env on the host running docker-compose:
#   cp env.v4-01.example .env
# .env is consumed by docker-compose for ${VAR} substitution.
#
# RDS lives in the 57 kHz subcarrier of the FM broadcast MPX composite, so this
# pipeline REQUIRES the V4 with the FM broadcast notch REMOVED. The V3 is
# FM-bandstopped by design and will never see RDS.
#
# The V4 is single-client: rds_reader.py connects to rtl_tcp as one TCP client,
# so rotate any other V4 decoder (acars/adsb/ais/ism) down first:
#   ./pipeline.sh rotate rds

# -- Tuner: rtl_tcp connection ---------------------------
# Where the V4's rtl_tcp is reachable from inside the container. With
# rtl_tcp.exe on Windows (the default USB strategy), host.docker.internal
# resolves to the Windows host. For a native (usbipd) rtl_tcp on the WSL side,
# use the host IP / host-gateway instead.
RTL_TCP_HOST=host.docker.internal
RTL_TCP_PORT=1235

# -- Station tuning --------------------------------------
# FM carrier to decode, in Hz. 99600000 = 99.6 MHz Kosmos FM (Athens reference
# station in notes/listening-playbook.md). RDS is public metadata: PS name, PI
# code, RadioText, PTY, TP/TA, clock-time.
RDS_FREQ_HZ=99600000

# -- Tuner gain ------------------------------------------
# RTL gain in dB. FM broadcast is strong in Athens; 29.7 is a good start. Too
# high overloads the 8-bit ADC and corrupts the subcarrier -> watch block_errors
# in the dashboard and drop gain if it climbs.
RDS_GAIN=29.7

# -- DSP knobs -------------------------------------------
# Sample rate (S/s). 228000 makes every RDS rate an integer ratio (57 kHz=fs/4,
# 19 kHz pilot=fs/12, 1187.5 bps=fs/192); change only if you know why.
RDS_SAMPLE_RATE=228000
# Pilot gate: median |pilot| below this => treat as no stereo pilot and emit
# nothing. 0.0 (off) decodes even a marginal capture; raise it if a mono
# neighbour bleeds in and produces junk groups.
RDS_PILOT_THRESH=0.0

# -- Identity --------------------------------------------
# Tagged on every rds.messages row so cross-pipeline queries can attribute
# groups to the source dongle.
RDS_DONGLE_ID=v4-01

# -- ClickHouse ------------------------------------------
# Default is dev-only. Set a non-trivial value (env-only, not committed) before
# exposing the shared ClickHouse, matching the ais/ism secret pattern.
CLICKHOUSE_PASSWORD=rds_local
